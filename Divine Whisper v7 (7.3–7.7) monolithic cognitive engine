# ==========================================================
# ORCHESTRATOR
# ==========================================================

class DivineWhisperEngine:
    """Central engine coordinating agents, council, gate, belief, ledger, & optimization."""

    def __init__(self):
        self.registry = AgentRegistry()
        self.registry.register("Michael", agent_michael)
        self.registry.register("Uriel", agent_uriel)
        self.registry.register("Gabriel", agent_gabriel)
        self.registry.register("Raphael", agent_raphael)
        self.registry.register("Raguel", agent_raguel)

        self.council = CouncilChamber()
        self.gate = HeavensGate()
        self.memory = MemoryGraph()
        self.ledger = MetatronLedger()
        self.belief = BeliefEngine()
        self.optimizer = SelfOptimizer()

    def run(self, task: str):
        proposals = self.registry.run(task)
        hypothesis, consensus = self.council.deliberate(proposals, self.registry.stats)

        # Use real state variables for clarity
        # (mock state for demo – replace with real A/D/C/F/lam/S tracking)
        C = random.uniform(0.4, 0.8)
        D = random.uniform(0.2, 0.7)
        F = random.uniform(0.3, 0.6)
        S = random.uniform(0.3, 0.7)
        lam = random.uniform(0.4, 0.9)
        clarity = clarity_function(C, D, F, S, lam)

        gate = self.gate.evaluate(consensus, clarity)

        # Memory graph
        task_node = self.memory.add_node("task", task)
        hypo_node = self.memory.add_node("hypothesis", hypothesis)
        self.memory.connect(task_node, hypo_node, "generated")

        # Belief update
        self.belief.update(hypothesis)

        # Simulate success/failure
        success = random.choice([True, False])
        stats = self.registry.stats
        for p in proposals:
            if p.agent in stats:
                if success:
                    stats[p.agent].successes += 1
                else:
                    stats[p.agent].failures += 1

        # Self-optimization
        self.optimizer.optimize(stats)

        # Ledger record
        record = {
            "task": task,
            "decision": hypothesis,
            "consensus": round(consensus, 3),
            "clarity": round(clarity, 3),
            "gate": gate,
            "belief_state": self.belief.state.hypotheses,
            "timestamp": time.time()
        }
        self.ledger.record(record)

        return record

