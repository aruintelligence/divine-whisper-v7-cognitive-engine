# ==========================================================
# CLARITY FUNCTION Ψ(t)
# ==========================================================

def clarity_function(C: float, D: float, F: float, S: float, lam: float, eps: float = 1e-6) -> float:
    """
    Core Inward Physics clarity: remembrance × coherence × salience / (distortion² × friction)
    """
    denominator = ((D + eps) ** 2) * (F + eps)
    raw = (lam * C * S) / denominator if denominator > 0 else 0.0
    return max(0.0, min(1.0, raw))

# ==========================================================
# DATA STRUCTURES
# ==========================================================

@dataclass
class AgentProposal:
    agent: str
    hypothesis: str
    confidence: float = field(default_factory=lambda: random.uniform(0.6, 0.95))

@dataclass
class AgentStats:
    agent: str
    successes: int = 0
    failures: int = 0
    reputation: float = 0.5

@dataclass
class BeliefState:
    hypotheses: Dict[str, float] = field(default_factory=dict)

# ==========================================================
# MEMORY GRAPH (v7.4)
# ==========================================================

class MemoryGraph:
    """Simple in-memory graph for knowledge storage."""

    def __init__(self):
        self.nodes: Dict[str, Dict] = {}
        self.edges: List[Tuple[str, str, str]] = []

    def add_node(self, node_type: str, data: Any) -> str:
        node_id = str(uuid.uuid4())
        self.nodes[node_id] = {"type": node_type, "data": data}
        return node_id

    def connect(self, a: str, b: str, relation: str):
        self.edges.append((a, relation, b))

# ==========================================================
# METATRON LEDGER
# ==========================================================

class MetatronLedger:
    """Append-only JSONL ledger for persistence."""

    def __init__(self, path: str = "ledger.jsonl"):
        self.path = Path(path)
        self.path.parent.mkdir(parents=True, exist_ok=True)

    def record(self, entry: Dict):
        try:
            with open(self.path, "a", encoding="utf-8") as f:
                json.dump(entry, f)
                f.write("\n")
        except Exception as e:
            logging.error(f"Ledger write failed: {e}")

# ==========================================================
# AGENT REGISTRY
# ==========================================================

class AgentRegistry:
    """Registry of agents with reputation tracking."""

    def __init__(self):
        self.agents: Dict[str, callable] = {}
        self.stats: Dict[str, AgentStats] = {}

    def register(self, name: str, fn: callable):
        self.agents[name] = fn
        self.stats[name] = AgentStats(agent=name)

    def run(self, task: str) -> List[AgentProposal]:
        proposals = []
        for name, fn in self.agents.items():
            try:
                response = fn(task)
                confidence = random.uniform(0.6, 0.95)  # placeholder
                proposals.append(AgentProposal(agent=name, hypothesis=response, confidence=confidence))
            except Exception as e:
                logging.warning(f"Agent {name} failed: {e}")
        return proposals

# ==========================================================
# COUNCIL CHAMBER (v7.5)
# ==========================================================

class CouncilChamber:
    """Deliberates proposals with reputation-weighted consensus."""

    def deliberate(self, proposals: List[AgentProposal], stats: Dict[str, AgentStats]):
        scores = []
        for p in proposals:
            rep = stats.get(p.agent, AgentStats(agent=p.agent)).reputation
            score = p.confidence * rep
            scores.append((score, p))

        if not scores:
            return "No proposals", 0.0

        scores.sort(reverse=True, key=lambda x: x[0])
        best = scores[0][1]
        consensus = np.mean([s for s, _ in scores]) if scores else 0.0

        return best.hypothesis, consensus

# ==========================================================
# HEAVEN'S GATE
# ==========================================================

class HeavensGate:
    """Evaluates consensus & clarity for decision gating."""

    def evaluate(self, consensus: float, clarity: float) -> str:
        if consensus < 0.65:
            return "revise"
        if clarity < 0.6:
            return "rethink"
        return "approve"

# ==========================================================
# BELIEF STATE + REGRET (v7.6)
# ==========================================================

class BeliefEngine:
    """Belief state with hypothesis tracking & regret calculation."""

    def __init__(self):
        self.state = BeliefState()

    def update(self, hypothesis: str):
        if hypothesis not in self.state.hypotheses:
            self.state.hypotheses[hypothesis] = 0.5
        self.state.hypotheses[hypothesis] += 0.1

    def regret(self, predicted: float, actual: float) -> float:
        return abs(predicted - actual)

# ==========================================================
# SELF OPTIMIZATION (v7.7)
# ==========================================================

class SelfOptimizer:
    """Updates agent reputation based on success rate."""

    def optimize(self, stats: Dict[str, AgentStats]):
        for agent in stats.values():
            total = agent.successes + agent.failures
            if total == 0:
                continue
            agent.reputation = agent.successes / total

